@inject PluginRegistry Plugins

<nav class="sidebar">
    <div class="brand">
        <StatusBlock State="running" CssClass="block--mark" Label="McAdmin"/>
        <a class="brand-name" href="/">
            McAdmin
            <span class="brand-sub">Server console</span>
        </a>
    </div>

    <input class="sidebar-toggle" type="checkbox" id="sidebar-toggle" aria-label="Show navigation"/>

    <div class="nav">
        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
            <span class="nav-glyph glyph-console" aria-hidden="true"></span> Console
        </NavLink>

        <NavLink class="nav-link" href="/settings">
            <span class="nav-glyph glyph-settings" aria-hidden="true"></span> Server settings
        </NavLink>

        <NavLink class="nav-link" href="/whitelist">
            <span class="nav-glyph glyph-whitelist" aria-hidden="true"></span> Whitelist
        </NavLink>

        <NavLink class="nav-link" href="/account">
            <span class="nav-glyph glyph-account" aria-hidden="true"></span> Your account
        </NavLink>

        @if (Plugins.NavItems.Count > 0)
        {
            <div class="nav-section eyebrow">Plugins</div>

            @foreach (var item in Plugins.NavItems)
            {
                @if (item.AdministratorOnly)
                {
                    <AuthorizeView Roles="@UserRoles.Administrator">
                        @PluginLink(item)
                    </AuthorizeView>
                }
                else
                {
                    @PluginLink(item)
                }
            }
        }

        <AuthorizeView Roles="@UserRoles.Administrator">
            <div class="nav-section eyebrow">Administration</div>
            <NavLink class="nav-link" href="/users">
                <span class="nav-glyph glyph-users" aria-hidden="true"></span> Accounts
            </NavLink>
        </AuthorizeView>
    </div>

    <AuthorizeView>
        <div class="sidebar-foot">
            <span class="avatar" aria-hidden="true">@Initial(context.User.Identity?.Name)</span>
            <span class="sidebar-identity">
                <strong>@context.User.Identity?.Name</strong>
                <span class="eyebrow">@(context.User.IsInRole(UserRoles.Administrator) ? "Administrator" : "User")</span>
            </span>
            <form method="post" action="/account/logout">
                <AntiforgeryToken/>
                <button type="submit" class="btn btn--link btn--small">Sign out</button>
            </form>
        </div>
    </AuthorizeView>
</nav>

@code {
    private static string Initial(string? name) =>
        string.IsNullOrEmpty(name) ? "?" : name[..1];

    // A plugin picks its own glyph out of app.css; anything unset gets the generic one.
    private static RenderFragment PluginLink(PluginNavItem item) =>
        @<NavLink class="nav-link" href="@item.Href">
            <span class="nav-glyph @(item.Glyph ?? "glyph-plugin")" aria-hidden="true"></span> @item.Text
        </NavLink>;
}
