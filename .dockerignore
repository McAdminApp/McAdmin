**/.vs
**/.idea
**/.git
**/bin
**/obj
**/data
**/*.user
**/*.DotSettings.user

# Build and deployment files that do not belong in the context.
docker-compose*.yml
Dockerfile
Jenkinsfile
**/*.md
artifacts/

# Local runtime data from the development machine. It would otherwise be dragged into
# the context and, where the paths line up, shadow what is mounted in the container.
**/*.db
**/*.db-shm
**/*.db-wal
**/whitelist.json
**/server.properties

# Local plugin folders used when running the app straight from the source tree.
# In the container these are a volume (/app/addons) and a bind mount (/app/plugins).
Web/src/addons/
Web/src/plugins/
