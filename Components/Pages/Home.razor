@page "/"
@attribute [Authorize]
@rendermode InteractiveServer

@implements IAsyncDisposable

@inject IMinecraftServerController Server
@inject IJSRuntime JS

<PageTitle>Console — McAdmin</PageTitle>

<div class="page-head">
    <span class="eyebrow">Console</span>
    <h1>@(snapshot?.Name ?? "Loading the server")</h1>
    <p>Start and stop the server, watch what it is saying, and see who is playing.</p>
</div>

<div class="page-body">
    <div class="stack">

        @if (!Server.IsConnected)
        {
            <div class="notice notice--warn">
                <span>
                    <strong>Nothing is wired up yet.</strong> The numbers below are placeholders.
                    Implement <span class="mono">IMinecraftServerController</span> in
                    <span class="mono">Services/MinecraftServer.cs</span> and register it in
                    <span class="mono">Program.cs</span> — this page reads everything through that interface.
                </span>
            </div>
        }

        @if (Problem is not null)
        {
            <div class="notice notice--error" role="alert">
                <span>@Problem</span>
            </div>
        }

        @if (snapshot is null)
        {
            <div class="slot">
                <div class="empty">Reading the server state…</div>
            </div>
        }
        else
        {
            <section class="slot">
                <div class="slot-body" style="display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap;">
                    <StatusBlock State="@BlockState" Label="@StateLabel"/>

                    <div style="flex: 1 1 14rem; min-width: 0;">
                        <span class="eyebrow">Status</span>
                        <h2 style="font-size: 1.5rem; margin: 0.15rem 0 0.3rem;">@StateLabel</h2>
                        <p class="muted" style="margin: 0;">
                            @(snapshot.StatusDetail ?? $"Listening on {snapshot.Address}")
                        </p>
                    </div>

                    <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
                        <button class="btn btn--primary" disabled="@(busy || snapshot.State is ServerState.Running or ServerState.Starting)"
                                @onclick="StartAsync">
                            Start server
                        </button>
                        <button class="btn" disabled="@(busy || snapshot.State is not ServerState.Running)"
                                @onclick="RestartAsync">
                            Restart
                        </button>
                        <button class="btn btn--danger" disabled="@(busy || snapshot.State is ServerState.Stopped or ServerState.Stopping)"
                                @onclick="StopAsync">
                            Stop server
                        </button>
                    </div>
                </div>

                <dl class="readout" style="border-top: 1px solid var(--edge-line); box-shadow: 0 -1px 0 var(--edge-lit);">
                    <div class="readout-cell">
                        <dt>Players</dt>
                        <dd>@snapshot.PlayersOnline<small>/ @snapshot.PlayerSlots</small></dd>
                    </div>
                    <div class="readout-cell">
                        <dt>Uptime</dt>
                        <dd>@FormatUptime(snapshot.Uptime)</dd>
                    </div>
                    <div class="readout-cell">
                        <dt>Version</dt>
                        <dd style="font-size: 1.05rem;">@snapshot.Version</dd>
                    </div>
                    <div class="readout-cell">
                        <dt>Address</dt>
                        <dd style="font-size: 1.05rem;" class="mono">@snapshot.Address</dd>
                    </div>
                </dl>
            </section>

            <div class="grid-2">
                <section class="slot">
                    <div class="slot-head">
                        <h2>Players</h2>
                        <span class="eyebrow">@players.Count online</span>
                    </div>

                    @if (players.Count == 0)
                    {
                        <div class="empty">
                            <h3>Nobody is online</h3>
                            <p class="muted" style="margin: 0;">Start the server to let players in.</p>
                        </div>
                    }
                    else
                    {
                        <table class="table">
                            <thead>
                            <tr>
                                <th>Name</th>
                                <th>Session</th>
                                <th>Ping</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var player in players)
                            {
                                <tr>
                                    <td><strong>@player.Name</strong></td>
                                    <td class="mono">@FormatUptime(player.SessionLength)</td>
                                    <td class="mono">@(player.Ping is { } ping ? $"{ping} ms" : "—")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </section>

                <section class="slot">
                    <div class="slot-head">
                        <h2>Server log</h2>
                        <button class="btn btn--link btn--small" @onclick="RefreshAsync" disabled="@busy">Refresh</button>
                    </div>

                    <div class="console slot--sunken" @ref="logPanel">
                        @foreach (var line in ConsoleLines)
                        {
                            <div class="console-line" data-level="@line.Level">
                                <span class="console-time">@line.Timestamp.ToString("HH:mm:ss")</span>
                                <span class="console-text">@line.Text</span>
                            </div>
                        }
                    </div>

                    <div class="command-bar">
                        <input type="text" placeholder="say hello" @bind="command" @bind:event="oninput"
                               disabled="@(!Server.IsConnected)" aria-label="Server command"/>
                        <button class="btn" @onclick="SendCommandAsync"
                                disabled="@(busy || !Server.IsConnected || string.IsNullOrWhiteSpace(command))">
                            Run
                        </button>
                    </div>
                </section>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>How often the page re-reads the server state on its own.</summary>
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(1);

    /// <summary>How much command output to keep below the log before the oldest is dropped.</summary>
    private const int MaxEchoLines = 200;

    private ServerSnapshot? snapshot;
    private IReadOnlyList<OnlinePlayer> players = [];
    private IReadOnlyList<ConsoleLine> log = [];

    /// <summary>
    /// What the commands typed here produced. RCON answers the caller and writes nothing to
    /// the server's own log, so these lines exist only in this page — the log panel would
    /// otherwise stay silent no matter what was run.
    /// </summary>
    private readonly List<ConsoleLine> echo = [];

    private string command = string.Empty;
    private string? actionError;
    private string? pollError;
    private bool busy;

    private ElementReference logPanel;
    private IJSObjectReference? scroller;
    private CancellationTokenSource? polling;
    private int scrolledAt = -1;

    private IEnumerable<ConsoleLine> ConsoleLines => log.Concat(echo);

    private string? Problem => actionError ?? pollError;

    // Only the first read happens here. The page is prerendered before it becomes
    // interactive, so this runs twice — once on an instance that is then thrown away — and
    // starting the timer here would leave that copy polling forever. It starts on first
    // render instead, which only the interactive instance reaches.
    protected override Task OnInitializedAsync() => RefreshAsync();

    /// <summary>Keeps every value on the page current without the user pressing anything.</summary>
    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshInterval);

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                // On the circuit's own context, so rendering stays on the thread Blazor expects.
                // A slow read delays the next tick rather than overlapping with it.
                await InvokeAsync(async () =>
                {
                    await RefreshAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // The page was closed.
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            snapshot = await Server.GetSnapshotAsync();
            players = await Server.GetPlayersAsync();
            log = await Server.GetRecentLogAsync();
            pollError = null;
        }
        catch (Exception ex)
        {
            // A stopped server is not an error — the controller reports that as state. This
            // is for the things that are, like a rejected RCON password.
            pollError = ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Imported rather than pulled in with a script tag: a tag rendered by a
            // component only runs when the page was loaded outright, not when Blazor
            // navigated here and patched it into the DOM.
            // "./" matters: Assets gives a path relative to the base href, and import()
            // treats one without it as a bare module name and refuses to resolve it.
            scroller = await JS.InvokeAsync<IJSObjectReference>(
                "import", $"./{Assets["Components/Pages/Home.razor.js"]}");

            polling = new CancellationTokenSource();
            _ = PollAsync(polling.Token);
        }

        var lines = log.Count + echo.Count;

        if (scroller is null || lines == scrolledAt)
        {
            return;
        }

        await scroller.InvokeVoidAsync("scrollToBottom", logPanel);
        scrolledAt = lines;
    }

    private Task StartAsync() => RunAsync(Server.StartAsync);

    private Task StopAsync() => RunAsync(Server.StopAsync);

    private Task RestartAsync() => RunAsync(Server.RestartAsync);

    private async Task SendCommandAsync()
    {
        var toRun = command.Trim();

        if (toRun.Length == 0)
        {
            return;
        }

        command = string.Empty;
        busy = true;
        actionError = null;

        Write("command", $"> {toRun}");

        try
        {
            var response = await Server.SendCommandAsync(toRun, CancellationToken.None);

            if (string.IsNullOrWhiteSpace(response))
            {
                Write("muted", "(the server answered with nothing)");
            }
            else
            {
                foreach (var line in response.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                {
                    Write("info", line.TrimEnd('\r'));
                }
            }

            await RefreshAsync();
        }
        catch (Exception ex)
        {
            actionError = ex.Message;
            Write("error", ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private void Write(string level, string text)
    {
        echo.Add(new ConsoleLine(DateTimeOffset.Now, level, text));

        if (echo.Count > MaxEchoLines)
        {
            echo.RemoveRange(0, echo.Count - MaxEchoLines);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (polling is not null)
        {
            await polling.CancelAsync();
            polling.Dispose();
        }

        if (scroller is not null)
        {
            try
            {
                await scroller.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser is already gone, so there is nothing left to release.
            }
        }
    }

    /// <summary>Runs one server action, keeps the buttons quiet while it works, and re-reads the state after.</summary>
    private async Task RunAsync(Func<CancellationToken, Task> action)
    {
        busy = true;
        actionError = null;

        try
        {
            await action(CancellationToken.None);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private string BlockState => snapshot?.State switch
    {
        ServerState.Running => "running",
        ServerState.Starting or ServerState.Stopping => "pending",
        ServerState.Faulted => "error",
        _ => "stopped"
    };

    private string StateLabel => snapshot?.State switch
    {
        ServerState.Running => "Running",
        ServerState.Starting => "Starting up",
        ServerState.Stopping => "Shutting down",
        ServerState.Faulted => "Stopped after an error",
        _ => "Stopped"
    };

    private static string FormatUptime(TimeSpan span) =>
        span.TotalSeconds < 1 ? "—"
        : span.TotalHours >= 1 ? $"{(int)span.TotalHours}h {span.Minutes:00}m"
        : $"{span.Minutes}m {span.Seconds:00}s";
}
